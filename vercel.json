{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "app/api/dashboard/estimation/[id]/rapport/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/dashboard/estimation/[id]/rapport/envoyer/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-portfolio",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/brief-matin",
      "schedule": "0 5 * * 1-6"
    }
  ]
}
