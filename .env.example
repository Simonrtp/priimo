# Copier vers .env.local — ne jamais committer de secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAIL=
INVITATION_ADMIN_SECRET=

RESEND_API_KEY=
# RESEND_FROM=

NEXT_PUBLIC_MAPBOX_TOKEN=
# Street View Static (proxy serveur — ne jamais exposer au client)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Beta (optionnel)
# BETA_BLOB_STORE=1
# BLOB_READ_WRITE_TOKEN=
# BETA_WEBHOOK_URL=

# Turnstile (optionnel — si absent, seuls les rate-limits s'appliquent)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Scripts d'approche on-demand (Mistral)
MISTRAL_API_KEY=

# Modèle de lecture des notes dictées. Par défaut ministral-8b-latest, avec
# repli ministral-3b-latest. À ne renseigner que pour épingler un modèle
# précis : les gros modèles rendent 429 sur les petits forfaits.
# MISTRAL_MODEL_NOTE=

# Cron Vercel (Bearer) — instantané hebdomadaire Accueil
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Abonnement (configuration — pas des constantes dans le code)
# ---------------------------------------------------------------------------
# BILLING_SIEGES_INCLUS=3
# BILLING_PRIX_BASE=149
# BILLING_PRIX_SIEGE=29
# BILLING_ESSAI_JOURS=14
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASE=
# STRIPE_PRICE_SIEGE=

# ---------------------------------------------------------------------------
# Diffusion sortante (passerelle — secrets serveur uniquement)
# ---------------------------------------------------------------------------
# DIFFUSION_GATEWAY=noop
# DIFFUSION_GATEWAY=ubiflow
# DIFFUSION_GATEWAY=diffuze
# UBIFLOW_API_KEY=
# UBIFLOW_API_BASE=https://api.ubiflow.net
# DIFFUZE_API_KEY=
# DIFFUZE_API_BASE=

# ---------------------------------------------------------------------------
# Captation Gmail (OAuth gmail.readonly — scope restreint Google)
# Prévoir vérification OAuth + audit annuel ; sinon plafond 100 users test.
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect Gmail (console Google Cloud → URIs autorisées) :
# GOOGLE_OAUTH_REDIRECT_URI=https://priimo.fr/api/dashboard/integrations/gmail/callback
# En local, ajoute aussi :
# http://localhost:3000/api/dashboard/integrations/gmail/callback
#
# Agenda : en production l’URI envoyée à Google est TOUJOURS
#   https://priimo.fr/api/dashboard/integrations/calendar/callback
# En local :
#   http://localhost:3000/api/dashboard/integrations/calendar/callback
# Les deux doivent figurer sur LE MÊME client OAuth que GOOGLE_OAUTH_CLIENT_ID
# (Identifiants → application Web, pas « iOS » / « Android »).
# Clé 32 octets en hex (64 chars) ou passphrase (hashée SHA-256)
# GMAIL_TOKEN_ENCRYPTION_KEY=

# Jeton des QR terrain (empreinte poivrée). Obligatoire en production.
# QR_TOKEN_PEPPER=
# GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-push
# Audience OIDC du push Pub/Sub (URL du webhook ou audience custom GCP)
# GMAIL_PUBSUB_OIDC_AUDIENCE=https://priimo.fr/api/webhooks/gmail
# Email du compte de service Pub/Sub (optionnel, restreint davantage)
# GMAIL_PUBSUB_OIDC_EMAIL=pubsub-push@YOUR_PROJECT.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# Notifications Web Push (brief du matin)
# Generer une fois : node scripts/generate-vapid.mjs
# Changer ces cles invalide tous les abonnements existants.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@priimo.fr

# ---------------------------------------------------------------------------
# Veille DPE (base publique ADEME - aucune cle requise)
# A surcharger seulement si l'ADEME renomme son jeu de donnees.
# ---------------------------------------------------------------------------
# ADEME_API_BASE=https://data.ademe.fr/data-fair/api/v1/datasets
# ADEME_DPE_DATASET=dpe03existant
